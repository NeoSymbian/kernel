// SPDX-License-Identifier: EPL-2.0
// values.hda -- HAL.DLL's static attribute values on NeoSymbian (QEMU virt and the Pixels; build's
// emitter/build_hal_device.py runs halservices/hal/halcfg.pl on it and config.hcf). From Syborg's values.hda
// (symbian-qemu baseport/syborg/hal, EPL-1.0, Nokia and NTT DOCOMO); The NeoSymbian Authors (2026): no mouse, a touch
// pen, the timing and CPU count from the kernel (config.hcf), comments.
//
// Kept on purpose (compatibility, not facts about the device): the manufacturer, model and machine UID key the HAL
// settings file (halsettings: C:\private\102825B1\HAL.DAT) and S60 .sis install conditions; ECPUABI arm5 matches the
// E32 image header's ECpuArmV5 (HAL has no ARMv8 value); the device family is Symbian's own.
EManufacturer=intel
EManufacturerHardwareRev=0x1
EManufacturerSoftwareRev=0x100
EManufacturerSoftwareBuild=0x250
EModel=0x42525453
EMachineUid=0x10005152
EDeviceFamily=crystal
EDeviceFamilyRev=0x001
ECPU=arm
ECPUArch=0xC0
ECPUABI=arm5
// ECPUSpeed: not supported (no fixed clock: cpufreq)

ESystemStartupReason=cold
ESystemException=0
ESystemTickPeriod=15625
EMemoryPageSize=0x1000
EPowerGood=1
EPowerExternal=1
// a touch screen, no mouse (the input drivers post pointer events in screen pixels)
EPen=1
EMouse=0
ECaseSwitch=0
EIntegratedPhone=0
ELanguageIndex=0
EDebugPort=0
EClipboardDrive=2
ESystemDrive=0xffff
EDisplayNumberOfScreens=1
// ENanoTickPeriod, EFastCounterFrequency, ENumCpus: from the kernel (config.hcf), each board its own
EFastCounterCountsUp=1
