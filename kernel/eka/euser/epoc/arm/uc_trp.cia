#include <e32cia.h>
#include <u32std.h>
#include <e32panic.h>
#include <u32exec.h>
#include "uc_std.h"

//  With -fvtable-thunks
//const TInt KVTableTrapOffset=8;
//const TInt KVTableLeaveOffset=16;

//  Without -fvtable-thunks
//  const TInt KVTableTrapOffset=12;
//  const TInt KVTableLeaveOffset=28;


#ifndef __LEAVE_EQUALS_THROW__

// NeoSymbian (US2, docs user-side-smp.md): code built with VFP (ARMv8 softfp) keeps values in d8-d15, which are
// callee-saved, so a leave must restore them as it restores r4-r11. TTrap has no room (iState[10..15] are the only
// spare words), so the TRAP macros of such code (toolchain/overlay/e32cmn.h in NeoSymbian/build) put 64 bytes right
// after the TTrap and call NeoTrapFp, which saves d8-d15 there and marks iState[KNeoTrapFpMark]; TTrap::Trap clears
// the mark, NeoTrapLongjmp restores d8-d15 only when it is set. Old RVCT apps leave by C++ exception, not TTrap.
const TInt KNeoTrapFpMark = 10;
const TUint32 KNeoTrapFpMagic = 0x4E454F46;		// "NEOF"

extern "C" __NAKED__ TInt NeoTrapFp(TTrap* /*aThis*/, TInt& /*aResult*/)
	{
	asm(".fpu vfpv2 ");						// d8-d15 exist on every VFP; the CPU always has one (US2)
	asm("add r2, r0, #%a0" : : "i" (sizeof(TTrap)));
	asm("vstmia r2, {d8-d15} ");			// the 64 bytes after the TTrap
	asm("movw r2, #%a0" : : "i" (KNeoTrapFpMagic & 0xFFFF));
	asm("movt r2, #%a0" : : "i" (KNeoTrapFpMagic >> 16));
	asm("str r2, [r0, #%a0]" : : "i" (_FOFF(TTrap,iState) + KNeoTrapFpMark * 4));
	asm("mov r2, #0 ");						// from here as TTrap::Trap, without clearing the mark
	asm("str r2, [r1, #0] ");
	asm("str r1, [r0, #%a0]" : : "i" _FOFF(TTrap,iResult));
	asm("stmia r0, {r4-r11, sp, lr} ");
	asm("stmfd sp!, {r4,lr} ");
	asm("bl  " CSM_ZN4Exec13PushTrapFrameEP5TTrap);
	asm("cmp r0, #0 ");
	asm("ldrne r3, [r0, #%a0]" : : "i" (_TTRAPHANDLER_VPTR_OFFSET_));
	asm("beq neo_trapfp_no_trap_handler ");
	asm("ldr r3, [r3, #%a0]" : : "i" (_TTRAPHANDLER_TRAP_OFFSET_));
	asm("adr lr, neo_trapfp_return ");		// iHandler->Trap()
	asm("bx r3 ");
	asm("neo_trapfp_return: ");
	asm("mov r0, #0 ");
	asm("neo_trapfp_no_trap_handler: ");
	__POPRET("r4,");
	}

EXPORT_C __NAKED__ TInt TTrap::Trap(TInt & /*aResult*/)
//
// Save the enter frame state and return 0.
//
	{

	asm("mov r2, #0 ");						// aResult==KErrNone
	asm("str r2, [r0, #%a0]" : : "i" (_FOFF(TTrap,iState) + KNeoTrapFpMark * 4));	// NeoSymbian: no d8-d15 saved
	asm("str r2, [r1, #0] ");				// iResult=(&aResult)
	asm("str r1, [r0, #%a0]" : : "i" _FOFF(TTrap,iResult));
	asm("stmia r0, {r4-r11, sp, lr} ");		// Save the context
	asm("stmfd sp!, {r4,lr} ");
	asm("bl  " CSM_ZN4Exec13PushTrapFrameEP5TTrap);
	asm("cmp r0, #0 ");						// == NULL
	asm("ldrne r3, [r0, #%a0]" : : "i" (_TTRAPHANDLER_VPTR_OFFSET_));
	asm("beq ttrap_trap_no_trap_handler ");
#ifdef __SUPPORT_THUMB_INTERWORKING
	asm("ldr r3, [r3, #%a0]" : : "i" (_TTRAPHANDLER_TRAP_OFFSET_));
	asm("adr lr, __ttrap_trap_return ");	// iHandler->Trap()
	asm("bx r3 ");
#else
	asm("adr lr, __ttrap_trap_return ");	// iHandler->Trap()
	asm("ldr pc, [r3, #%a0]" : : "i" (_TTRAPHANDLER_TRAP_OFFSET_));
#endif
	asm("__ttrap_trap_return: ");
	asm("mov r0, #0							");
	asm("ttrap_trap_no_trap_handler: ");
	__POPRET("r4,");
	}

extern void PanicNoTrapFrame();



// NeoSymbian: the second half of the 2010 User::Leave -- User::Leave (us_trp.cpp) has popped aFrame, which is a
// TTrap::Trap frame: call its handler's Leave and return 1 from that TTrap::Trap
__NAKED__ void NeoTrapLongjmp(TTrap* /*aFrame*/, TInt /*aReason*/)
	{
	asm("mov r4, r1 ");						// Save aReason
	asm("ldr r1, [r0, #%a0]" : : "i" _FOFF(TTrap,iResult));
	asm("mov r5, r0 ");						// Save it for later
	asm("ldr r0, [r0, #%a0]" : : "i" _FOFF(TTrap,iHandler));
	asm("str r4, [r1, #0] ");				// *(pT->iResult)=aReason
	asm("cmp r0, #0 ");
	asm("ldrne r2, [r0, #%a0]" : : "i" (_TTRAPHANDLER_VPTR_OFFSET_));
	asm("beq user_leave_no_trap_handler ");	// No trap handler
	asm("mov r1, r4 ");						// Pass aReason
#ifdef __SUPPORT_THUMB_INTERWORKING
	asm("ldr r3, [r2, #%a0]" : : "i" (_TTRAPHANDLER_LEAVE_OFFSET_));
	asm("adr lr, user_leave_no_trap_handler ");	// iHandler->Leave(aReason)
	asm("bx r3 ");
#else
	asm("adr lr, user_leave_no_trap_handler ");	// iHandler->Leave(aReason)
	asm("ldr pc, [r2, #%a0]" : : "i" (_TTRAPHANDLER_LEAVE_OFFSET_));
#endif
	asm("user_leave_no_trap_handler: ");
	asm(".fpu vfpv2 ");
	asm("ldr r2, [r5, #%a0]" : : "i" (_FOFF(TTrap,iState) + KNeoTrapFpMark * 4));	// NeoSymbian: d8-d15 from NeoTrapFp
	asm("movw r3, #%a0" : : "i" (KNeoTrapFpMagic & 0xFFFF));
	asm("movt r3, #%a0" : : "i" (KNeoTrapFpMagic >> 16));
	asm("cmp r2, r3 ");
	asm("addeq r2, r5, #%a0" : : "i" (sizeof(TTrap)));
	asm("vldmiaeq r2, {d8-d15} ");
	asm("ldmia	r5, {r4-r11, sp, lr} ");	// Restore the context
	asm("mov	r0, #1 ");					// return(1)
	__JUMP(,lr);							// return
	}

#endif // !__LEAVE_EQUALS_THROW__
